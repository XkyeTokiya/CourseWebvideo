    {
      "a_id": "A004",
      "callback_a_ids": [
        "A001"
      ],
      "nx": "【正文讲解】\nOID 是对象标识符，英文是 Object Identifier。它用来对任意类型的对象、概念或者事物进行全球无歧义、唯一的命名。这里说的对象范围很宽，既可以是产品，也可以是算法、文件，或者任何需要被区分开的数字对象。一个对象有了这样的名字，换到哪个组织、哪个系统，都只对应这一份解释。\n\n还要说明一点，OID 是一套命名体系，但它不只是一个数字串。命名规则、分配方案、编码规则和解析管理体系，都属于同一套体系。把这四部分放在一起看，它更像一棵有管理边界的树：先定下从哪里分叉，再定下每个分支怎样继续往下命名，把走过的整条路径写成编码。学 OID，重点是看清这棵树的形状。\n\n",
      "teaching_purpose": "展开根节点下的三个分支",
      "single_message": "根节点下按管理和命名分成 ITU、ISO 与联合三个分支，编号是 0、1、2。",
      "screen": {
        "title": {
          "screen_item_id": "S011",
          "guidance_text": "根节点下的三个根分支",
          "usage_policy": "reference",
          "evidence_refs": [
            "E004"
          ]
        },
        "groups": [
          {
            "group_id": "G008",
            "items": [
