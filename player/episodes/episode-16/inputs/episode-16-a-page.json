    {
      "a_id": "A007",
      "callback_a_ids": [
        "A006"
      ],
      "nx": "前缀本身也是分层的。从一级前缀开始，前缀可以向右依次扩展。以示例前缀为例，86 扩展一段变成 86.100，再扩展一段变成 86.100.12。每向右多一段，管理的位置就更细一层：先是国家这一级，再收到行业这一级，最后落到具体企业这一级。刚才那三段前缀，只是说明分级会逐层细化，并不代表所有前缀都固定是三层，也不说明每一段必须用固定的长度。\n\n",
      "teaching_purpose": "解释前缀向右逐级细化及其非固定边界",
      "single_message": "前缀逐级细化，但不固定层数，也不固定每段长度。",
      "screen": {
        "title": {
          "screen_item_id": "S019",
          "guidance_text": "前缀怎样逐级扩展",
          "usage_policy": "reference",
          "evidence_refs": [
            "E006"
          ]
        },
        "groups": [
          {
            "group_id": "G013",
            "items": [
