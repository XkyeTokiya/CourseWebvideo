    {
      "a_id": "A001",
      "callback_a_ids": [],
      "nx": "【开场导入】\n想象一件新能源汽车零部件，从工厂下线出发，经过仓储、装配，一直到维修环节。沿途每一个环节都会把它记录一次，可记录它的却是好几套互不相干的系统。真正麻烦的地方不在于给它贴一张标签，而在于每个环节都要能确认：我这条记录和别人的记录，说的是不是同一件东西？\n\n这正是标识编码要回答的设计问题。那么，它到底是一种什么样的编码，又承担着哪些职责？\n\n",
      "teaching_purpose": "用跨环节记录情境提出对象身份问题",
      "single_message": "难点不是贴标签，而是确认多条记录指向同一对象。",
      "screen": {
        "title": {
          "screen_item_id": "S001",
          "guidance_text": "同一件零部件，为什么认不出来",
          "usage_policy": "reference",
          "evidence_refs": [
            "E009"
          ]
        },
        "groups": [
          {
            "group_id": "G001",
            "items": [
              {
                "screen_item_id": "S002",
                "guidance_text": "零部件在工厂、仓储、装配和维修中被多次记录",
                "usage_policy": "reference",
