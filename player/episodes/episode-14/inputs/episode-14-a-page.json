                  "E009"
                ]
              }
            ]
          },
          {
            "group_id": "G002",
            "items": [
              {
                "screen_item_id": "S003",
                "guidance_text": "同一对象的多条记录必须能互相对应",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E009"
                ]
              },
              {
                "screen_item_id": "S004",
                "guidance_text": "对象身份问题是标识编码的设计问题",
                "usage_policy": "reference",
