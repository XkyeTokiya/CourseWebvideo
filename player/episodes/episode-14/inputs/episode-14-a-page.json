    {
      "a_id": "A002",
      "callback_a_ids": [
        "A001"
      ],
      "nx": "【正文讲解】\n工业互联网标识编码，是一种用来区分对象的身份符号。它能识别机器、产品这类物理资源，也能识别算法、工序这类虚拟资源。物理资源是看得见摸得着的实物，虚拟资源则是生产过程里的方法和步骤，它们同样需要在系统里被认出来。\n\n用一套统一的编码，好处是减少信息孤岛。所谓信息孤岛，就是各个系统、各个部门各自保存着自己的数据，彼此对不上。统一编码之后，不同企业、不同系统之间的数据才容易关联起来。跨企业、跨地域的管理，追踪溯源，还有多方协同，都要靠这个共同基础。\n\n",
      "teaching_purpose": "建立标识编码的定义与作用",
      "single_message": "统一编码让对象有共同身份，数据才易于关联。",
      "screen": {
        "title": {
          "screen_item_id": "S005",
          "guidance_text": "标识编码是什么",
          "usage_policy": "reference",
          "evidence_refs": [
            "E003"
          ]
        },
        "groups": [
          {
            "group_id": "G003",
            "items": [
              {
                "screen_item_id": "S006",
                "guidance_text": "物理资源：机器、产品等实物对象",
