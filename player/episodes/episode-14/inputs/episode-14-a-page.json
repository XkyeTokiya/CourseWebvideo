                "guidance_text": "先明确对象边界和适用范围",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E004"
                ]
              },
              {
                "screen_item_id": "S017",
                "guidance_text": "唯一性不等于脱离场景的绝对承诺",
                "usage_policy": "exact",
                "evidence_refs": [
                  "E004"
                ]
              }
            ]
          }
        ]
      },
