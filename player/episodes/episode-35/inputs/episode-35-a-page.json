    {
      "a_id": "A007",
      "callback_a_ids": [],
      "nx": "把候选放到一起比较。条形码、二维码通常成本低，偏向一次性使用；RFID的使用成本相对高一些，但存储容量和多标签识别是它跟前两者不一样的地方。成本要跟对象价值、使用次数、读写方式、现场维护负担放在一起看。便宜的标签要是清洗之后读不出来，补印、重贴、人工核对的开销会一路跟着来；反过来，成本高一些的方案，要是现场没有合适的设备，同样落不了地。\n\n",
      "teaching_purpose": "给出候选载体的定性比较与成本判断维度",
      "single_message": "候选比较保持定性，成本要和维护负担、设备条件一起看",
      "screen": {
        "title": {
          "screen_item_id": "S028",
          "guidance_text": "候选定性比较：成本只是维度之一",
          "usage_policy": "reference",
          "evidence_refs": [
            "E003",
            "E009"
          ]
        },
        "groups": [
          {
            "group_id": "G011",
            "items": [
              {
                "screen_item_id": "S029",
                "guidance_text": "一维码、二维码：成本低，偏一次性使用",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003"
                ]
              }
            ]
          },
          {
            "group_id": "G012",
            "items": [
              {
                "screen_item_id": "S030",
                "guidance_text": "RFID：使用成本相对较高；存储容量与多标签识别是差异点",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003"
                ]
              }
            ]
          },
          {
            "group_id": "G013",
            "items": [
              {
                "screen_item_id": "S031",
                "guidance_text": "比较保持定性：不出现价格、容量等具体数字",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003"
                ]
              },
              {
                "screen_item_id": "S032",
                "guidance_text": "成本与对象价值、使用次数、读写方式、现场维护负担一起看",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003",
