                ]
              }
            ]
          }
        ]
      },
      "protected_relations": [],
      "silent_constraints": [],
      "entry_condition": "观众已知选型是三项组合",
      "exit_condition": "观众能对给定对象列出形态与空间方面的可行性检查项",
