                "screen_item_id": "S033",
                "guidance_text": "隐性负担：清洗后读不出带来补印、重贴、人工核对；没有合适设备则高成本方案同样落地不了",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003",
                  "E009"
                ]
              }
            ]
          }
        ]
      },
      "protected_relations": [],
      "silent_constraints": [
        {
          "constraint_id": "C003",
          "instruction": "教材定性比较不得转换为价格、容量、距离、速度或成功率等数字",
          "evidence_refs": [
            "E003"
          ]
        }
      ],
      "entry_condition": "观众已知三类约束",
      "exit_condition": "观众不会把定性比较换算成数字，并会追问隐性维护负担",
