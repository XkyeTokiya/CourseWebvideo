    {
      "a_id": "A002",
      "callback_a_ids": [
        "A001"
      ],
      "nx": "数据共享是工业数据流通和应用的基础，但真正做起来并不容易。难点主要来自三个方面：数据由不同系统产生，结构和格式各不相同，这是“异构”；数据分布在不同地点，这是“异地”；数据又归属于不同主体，这是“异主”。三类差异叠加在一起，就形成了信息孤岛。这样的孤岛不仅存在于企业之间，在同一家企业的不同部门、不同系统之间也很常见。",
      "teaching_purpose": "解释挑战的来源",
      "single_message": "异构、异地、异主叠加形成信息孤岛。",
      "screen": {
        "title": {
          "screen_item_id": "S005",
          "guidance_text": "数据共享难在哪里",
          "usage_policy": "reference",
          "evidence_refs": [
            "E002"
          ]
        },
        "groups": [
          {
            "group_id": "G004",
            "items": [
              {
                "screen_item_id": "S006",
                "guidance_text": "异构：数据由不同系统产生，结构和格式各不相同",
                "usage_policy": "exact",
                "evidence_refs": [
                  "E002"
                ]
              },
              {
                "screen_item_id": "S007",
                "guidance_text": "异地：数据分布在不同地点",
                "usage_policy": "exact",
                "evidence_refs": [
                  "E002"
                ]
              },
              {
                "screen_item_id": "S008",
                "guidance_text": "异主：数据归属不同主体",
                "usage_policy": "exact",
                "evidence_refs": [
                  "E002"
                ]
              }
            ]
          },
          {
            "group_id": "G005",
            "items": [
