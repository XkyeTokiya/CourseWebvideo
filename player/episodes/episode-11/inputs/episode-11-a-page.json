    {
      "a_id": "A006",
      "callback_a_ids": [
        "A005"
      ],
      "nx": "这里说的标识解析，是工业互联网语境中的标识解析。它要解决的，是其中最基础的一件事：让每一个对象有自己唯一的身份。它可以为供应链里的物理实体和数字对象赋予全球唯一的编码，再通过解析，找到这个编码对应的位置和相关信息。",
      "teaching_purpose": "说明标识解析解决的基础问题",
      "single_message": "标识解析先解决对象的唯一身份与查询。",
      "screen": {
        "title": {
          "screen_item_id": "S022",
          "guidance_text": "标识解析解决的基础问题",
          "usage_policy": "reference",
          "evidence_refs": [
            "E005"
