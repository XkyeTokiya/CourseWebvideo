  "pages": [
    {
      "a_id": "A001",
      "callback_a_ids": [],
      "nx": "在药房收货的时候，工作人员会先核验一盒药品。这个动作看起来很简单，但它后面跟着一串问题：这盒药是谁生产的？中间经过了哪些仓储和物流环节？如果出了问题，应该向谁追查？",
      "teaching_purpose": "用一次现场核验引出跨阶段追踪问题",
      "single_message": "认出一盒药品只是追踪的开始。",
      "screen": {
        "title": {
          "screen_item_id": "S001",
          "guidance_text": "药房收货时的一次核验",
          "usage_policy": "reference",
          "evidence_refs": [
            "E012"
          ]
        },
        "groups": [
          {
            "group_id": "G001",
            "items": [
              {
                "screen_item_id": "S002",
                "guidance_text": "现场核验一盒药品的身份",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E012"
                ]
              }
            ]
          },
          {
            "group_id": "G002",
            "items": [
              {
                "screen_item_id": "S003",
                "guidance_text": "这一盒由谁生产、经过哪一段仓储和物流",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E012"
                ]
              }
            ]
          },
          {
            "group_id": "G003",
            "items": [
              {
                "screen_item_id": "S004",
                "guidance_text": "出现异常时向哪里追查",
                "usage_policy": "reference",
