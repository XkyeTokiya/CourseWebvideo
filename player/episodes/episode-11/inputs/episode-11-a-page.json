    {
      "a_id": "A003",
      "callback_a_ids": [
        "A002"
      ],
      "nx": "麻烦在于，有记录不等于信息互相认识。原材料供应商记的是原料批次，生产商记的是生产工单，物流商记的是运输单据，药店记的是销售流水。这些记录各自都很清楚，彼此之间却缺少一个共同的依据。药品供应链很长，参与方又多。不同主体之间的编码规则、数据口径和系统接口如果不一致，上下游的信息就不容易关联起来，也容易形成一个个数据孤岛。",
      "teaching_purpose": "说明记录清楚但彼此不识别",
      "single_message": "有记录不等于信息互相认识。",
      "screen": {
        "title": {
          "screen_item_id": "S009",
          "guidance_text": "有记录不等于互相认识",
          "usage_policy": "reference",
          "evidence_refs": [
            "E003",
            "E004"
          ]
        },
        "groups": [
