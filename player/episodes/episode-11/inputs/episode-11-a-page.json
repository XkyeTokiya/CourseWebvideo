            "group_id": "G004",
            "items": [
              {
                "screen_item_id": "S006",
                "guidance_text": "原材料供应商、生产商、物流商依次承担一段",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003"
                ]
              }
            ]
          },
          {
            "group_id": "G005",
            "items": [
              {
                "screen_item_id": "S007",
                "guidance_text": "经销商、零售商、药店和医院把药送到使用者",
                "usage_policy": "reference",
                "evidence_refs": [
                  "E003"
                ]
              }
            ]
          },
          {
            "group_id": "G006",
