  "a_pages": [
    {
      "a_id": "A001",
      "units": [
        {"id":"A001-N01","text":"工厂的收货区里，一批金属零部件刚完成核验。","boundary":"sentence"},
        {"id":"A001-N02","text":"质检员拿起扫码终端，对准其中一件轻轻一扫，终端确认了身份：就是它。","boundary":"sentence"},
        {"id":"A001-N03","text":"事情好像办完了，可质检员没有放下终端，新的问题一个接一个：","boundary":"clause"},
        {"id":"A001-N04","text":"这个零件属于哪个批次？","boundary":"question"},
        {"id":"A001-N05","text":"当前状态怎样？","boundary":"question"},
        {"id":"A001-N06","text":"相关说明去哪里查看？","boundary":"question"},
        {"id":"A001-N07","text":"编码帮我们确认了“查的是谁”，却没有把答案摆在眼前。","boundary":"sentence"},
        {"id":"A001-N08","text":"读到身份，只是查询的起点。","boundary":"sentence"},
        {"id":"A001-N09","text":"真正的问题是：拿着这个编码，去哪里查，又能查到什么？","boundary":"question"},
        {"id":"A001-N10","text":"我们就沿着这个问题，看标识解析体系怎样把一个编码，变成可以查询的信息。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A002",
      "units": [
        {"id":"A002-N01","text":"先把编码的角色说清楚。","boundary":"sentence"},
        {"id":"A002-N02","text":"编码是对象的身份键。","boundary":"sentence"},
        {"id":"A002-N03","text":"什么是身份键？","boundary":"question"},
        {"id":"A002-N04","text":"就是回答“这是谁”的钥匙，帮系统把一个对象同其他对象区分开。","boundary":"sentence"},
        {"id":"A002-N05","text":"至于它属于哪个批次、放在什么位置、状态怎样，这些信息可以和身份关联，但不必全部塞进编码本身。","boundary":"sentence"},
        {"id":"A002-N06","text":"为什么不塞进去？","boundary":"question"},
        {"id":"A002-N07","text":"信息一变，编码就得跟着改，身份就不再是稳定的锚点了。","boundary":"sentence"},
        {"id":"A002-N08","text":"身份键要的是稳定：","boundary":"clause"},
        {"id":"A002-N09","text":"信息可以挂在身份下面随时更新，键本身不能乱动。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A003",
      "units": [
        {"id":"A003-N01","text":"那么，从身份键到这些信息，中间靠什么？","boundary":"question"},
        {"id":"A003-N02","text":"靠标识解析体系。","boundary":"sentence"},
        {"id":"A003-N03","text":"它把设备、服务、产品这些实体的标识符，解析成地址、位置、元数据等相关信息。","boundary":"sentence"},
        {"id":"A003-N04","text":"注意，“解析”不是把字符拆开读含义，而是系统根据这个标识，完成定位和查询。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A004",
      "units": [
        {"id":"A004-N01","text":"说起“提交一个名称、拿回一个结果”，有个更熟悉的例子：域名解析系统，也就是 DNS。","boundary":"sentence"},
        {"id":"A004-N02","text":"在浏览器里输入一个好记的域名，系统会把它关联到访问网络所需的结果。","boundary":"sentence"},
        {"id":"A004-N03","text":"工业互联网的标识解析，也有“提交标识、获得结果”的映射关系。","boundary":"sentence"},
        {"id":"A004-N04","text":"这是两边共同的地方。","boundary":"sentence"},
        {"id":"A004-N05","text":"不过，类比不能走得太远。","boundary":"sentence"},
        {"id":"A004-N06","text":"互联网上解析的多是域名；","boundary":"clause"},
        {"id":"A004-N07","text":"工业世界要解析的对象，可能是设备、产品、零部件，也可能是算法、工序这样的虚拟资源；","boundary":"clause"},
        {"id":"A004-N08","text":"查回来的结果，可能是地址、位置，也可能是元数据。","boundary":"sentence"},
        {"id":"A004-N09","text":"两边共同的是“解析映射”；","boundary":"clause"},
        {"id":"A004-N10","text":"至于协议、治理方式和返回内容，并不相同。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A005",
      "units": [
        {"id":"A005-N01","text":"看清了类比和边界，再看标识解析体系的构成。","boundary":"sentence"},
        {"id":"A005-N02","text":"它由两个相互配合的部分组成：","boundary":"clause"},
        {"id":"A005-N03","text":"标识编码给机器、产品、零部件以及虚拟资源赋予身份；","boundary":"clause"},
        {"id":"A005-N04","text":"解析系统利用身份完成唯一定位和信息查询。","boundary":"sentence"},
        {"id":"A005-N05","text":"两部分缺一不可：","boundary":"clause"},
        {"id":"A005-N06","text":"没有稳定编码，不知道查谁；","boundary":"clause"},
        {"id":"A005-N07","text":"只有编码、没有解析系统，又找不到关联的信息。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A006",
      "units": [
        {"id":"A006-N01","text":"现在回到那个零部件。","boundary":"sentence"},
        {"id":"A006-N02","text":"质检员提交编码后，请求先进入一个可以访问的查询入口，再由体系逐层判断该到哪里去找相关记录。","boundary":"sentence"},
        {"id":"A006-N03","text":"这条链路可以概括成一条语义路径：","boundary":"clause"},
        {"id":"A006-N04","text":"提交标识，找到负责范围，定位到企业侧的信息或访问入口，结果返回给查询的人。","boundary":"sentence"},
        {"id":"A006-N05","text":"这是帮助理解协作的路径，不是固定的操作步骤。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A007",
      "units": [
        {"id":"A007-N01","text":"路径的入口处，有一个专门的角色：递归解析节点。","boundary":"sentence"},
        {"id":"A007-N02","text":"它面向查询者，提供公共查询和访问入口，接收问题，协助沿体系寻找答案。","boundary":"sentence"},
        {"id":"A007-N03","text":"为了把服务做得更快，它还可以利用缓存。","boundary":"sentence"},
        {"id":"A007-N04","text":"所谓缓存，就是把查过的结果先记下来，再有同样的请求，就不用从头找一遍。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A008",
      "units": [
        {"id":"A008-N01","text":"再往体系上方看。","boundary":"sentence"},
        {"id":"A008-N02","text":"国际根节点面向全球，提供根区数据管理和根解析服务。","boundary":"sentence"},
        {"id":"A008-N03","text":"国家顶级节点与全球根节点互联，还支持跨二级节点、跨不同标识解析体系之间的互联。","boundary":"sentence"},
        {"id":"A008-N04","text":"它们解决的是更大范围的协同：","boundary":"clause"},
        {"id":"A008-N05","text":"该向哪个体系、哪个服务范围继续寻找。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A009",
      "units": [
        {"id":"A009-N01","text":"再往下看。","boundary":"sentence"},
        {"id":"A009-N02","text":"二级节点更贴近行业，面向行业提供标识注册和解析服务；","boundary":"clause"},
        {"id":"A009-N03","text":"企业节点服务特定工业企业，同样承担注册和解析，还可以结合企业特点定义数据访问方式。","boundary":"sentence"},
        {"id":"A009-N04","text":"请求就这样一层层缩小范围，落到具体企业能提供的信息或访问入口上。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A010",
      "units": [
        {"id":"A010-N01","text":"把这几个角色放在一起看，它们不是五个孤立的数据库。","boundary":"sentence"},
        {"id":"A010-N02","text":"国际根和国家顶级管大范围协同，二级节点连接行业，企业节点贴近对象和数据，递归解析节点守在查询者一侧。","boundary":"sentence"},
        {"id":"A010-N03","text":"分层协作的意义在于：","boundary":"clause"},
        {"id":"A010-N04","text":"查询能在不同服务范围之间找到负责的角色，查询的人不必预先知道信息存放在哪里。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A011",
      "units": [
        {"id":"A011-N01","text":"当然，查回来的是什么，还要守住边界。","boundary":"sentence"},
        {"id":"A011-N02","text":"解析结果可能是地址、位置、元数据这样的信息，也可能是继续访问某项服务的入口；","boundary":"clause"},
        {"id":"A011-N03","text":"企业还可以定义自己的数据访问方式。","boundary":"sentence"},
        {"id":"A011-N04","text":"解析成功，不等于扫码后就能无条件拿到对象的全部生产、质量或商业数据。","boundary":"sentence"}
      ]
    },
    {
      "a_id": "A012",
      "units": [
        {"id":"A012-N01","text":"再回头看质检员的扫码动作：","boundary":"clause"},
        {"id":"A012-N02","text":"终端读出编码，编码充当身份键；","boundary":"clause"},
        {"id":"A012-N03","text":"查询入口接收请求，分层体系定位负责范围；","boundary":"clause"},
        {"id":"A012-N04","text":"企业侧把身份关联到信息或访问方式；","boundary":"clause"},
        {"id":"A012-N05","text":"结果返回业务现场。","boundary":"sentence"},
        {"id":"A012-N06","text":"走完这一圈，编码才从一串可识别的字符，变成能支撑信息查询的基础。","boundary":"sentence"},
        {"id":"A012-N07","text":"走到这里，可以把主线收拢了：","boundary":"clause"},
        {"id":"A012-N08","text":"编码回答“查谁”，解析回答“去哪里查、能得到什么”，一层层节点让查询跨范围协作。","boundary":"sentence"},
        {"id":"A012-N09","text":"至于建了多少节点、分布在哪些城市，这些数据会随时间变化；","boundary":"clause"},
        {"id":"A012-N10","text":"这条稳定的机制主线，才是理解标识解析体系的钥匙。","boundary":"sentence"}
      ]
    }
  ]
}
