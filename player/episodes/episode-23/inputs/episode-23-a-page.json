        "evidence_refs": [
         "E002"
        ]
       },
       {
        "screen_item_id": "S009",
        "guidance_text": "主体之间有规则或协议",
        "usage_policy": "exact",
        "evidence_refs": [
         "E002"
        ]
       },
       {
        "screen_item_id": "S010",
        "guidance_text": "数据能被共同利用",
        "usage_policy": "exact",
        "evidence_refs": [
