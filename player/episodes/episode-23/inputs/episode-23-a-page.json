     {
      "group_id": "G005",
      "items": [
       {
        "screen_item_id": "S011",
        "guidance_text": "文件发出去只说明传输发生了；对方能不能看懂、能不能按约定去用，才决定共享成不成立",
        "usage_policy": "reference",
        "evidence_refs": [
         "E002"
        ]
       },
       {
        "screen_item_id": "S012",
        "guidance_text": "共享不是无条件开放，不是集中存储，更不是谁来了都能随手取用",
        "usage_policy": "exact",
        "evidence_refs": [
         "E002"
        ]
       }
      ]
     }
    ]
