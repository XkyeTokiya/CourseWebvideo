  {
   "a_id": "A011",
   "callback_a_ids": [
    "A008"
   ],
   "nx": "具体到工业任务，有几类场景很常见。生产管理里，二维码可以附着在设备、原材料、半成品和成品上，支持任务领取和相关信息绑定。物料管理里，扫码确认入库、出库、库存和上线投放的位置。质量管理里，操作员扫码，把质检结果和质量参数关联起来。维护保养里，维护人员通过设备上的标识，查找维护历史、保养日期和维修记录。\n\n",
   "teaching_purpose": "把教材四类工业任务映射到二维码的关联能力：生产、物料、质量、维护。",
   "single_message": "四类任务的共同点是对象身份与现场动作可靠对应。",
   "screen": {
    "title": {
     "screen_item_id": "S051",
     "guidance_text": "四类工业任务：对象身份与现场动作",
     "usage_policy": "reference",
     "evidence_refs": [
      "E007"
     ]
    },
    "groups": [
     {
      "group_id": "G039",
      "items": [
