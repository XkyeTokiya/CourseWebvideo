                "usage_policy": "reference",
                "evidence_refs": [
                  "E008"
                ]
              }
            ]
          },
          {
            "group_id": "G024",
            "items": [
              {
                "screen_item_id": "S031",
                "guidance_text": "两件事连起来，对象有了唯一位置，原有管理习惯也能延续",
