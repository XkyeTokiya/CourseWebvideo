  "pages": [
    {
      "a_id": "A001",
      "callback_a_ids": [],
      "nx": "【视频标题】VAA 编码：从发码机构到企业内部编码\n\n【开场导入】\n一块新能源汽车电池从生产企业下线，接着要经过运输、销售、维护，最后还可能进入回收。每经过一个环节，都会有一套自己的系统把它记录一次，各自的编号也各不相同。\n\n怎样让运输方、销售方、维修方和回收方都确认，他们记录的是同一块电池？\n\n再加一串编号解决不了这件事，那只是又给它起了一个名字。VAA 编码的思路不一样，它给对象一个带层级的身份，让身份本身可以被管理起来。\n\n这套层级怎么搭？我们一层一层看。",
      "teaching_purpose": "提出跨环节身份问题",
      "single_message": "跨组织记录要确认指向同一个对象，靠的是带层级的身份，而不是再加一串编号。",
      "screen": {
        "title": {
          "screen_item_id": "S001",
          "guidance_text": "同一个对象怎样被认出来",
          "usage_policy": "reference",
